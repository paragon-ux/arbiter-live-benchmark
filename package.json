{
  "name": "arbiter-live-benchmark",
  "version": "2.2.0",
  "private": true,
  "description": "Live empirical multi-agent orchestration benchmark validating Arbiter worktree coordination, Waymark continuity, and fail-closed merge safety.",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "arbiter-live-benchmark": "./dist/src/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paragon-ux/arbiter-live-benchmark.git"
  },
  "bugs": {
    "url": "https://github.com/paragon-ux/arbiter-live-benchmark/issues"
  },
  "homepage": "https://github.com/paragon-ux/arbiter-live-benchmark#readme",
  "license": "MIT",
  "keywords": [
    "benchmark",
    "multi-agent",
    "orchestration",
    "arbiter",
    "waymark",
    "git-worktrees",
    "agent-continuity",
    "sqlite",
    "live-execution",
    "zero-dependencies"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage \"dist/test/**/*.test.js\"",
    "public-check": "node scripts/public-check.mjs",
    "calibrate": "node scripts/calibrate-tokens.mjs",
    "benchmark": "npm run build && node dist/src/cli/index.js --all",
    "compare": "node scripts/compare-baseline.mjs results/latest.json BASELINE_v2.1.0.json",
    "check:docs": "node scripts/check-doc-consistency.mjs && node scripts/check-doc-consistency.mjs --hypotheses",
    "check:table": "node scripts/generate-readme-table.mjs --check",
    "check:claims": "node scripts/claims-check.mjs",
    "check:hygiene": "node scripts/claims-hygiene.mjs",
    "check:checklist": "node scripts/check-checklist.mjs",
    "check:version": "node scripts/bump-version.mjs --check",
    "bump:version": "node scripts/bump-version.mjs",
    "verify": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\" && node scripts/public-check.mjs && npm run check:docs && npm run check:table && npm run check:claims && npm run check:hygiene && npm run check:checklist && npm run check:version"
  },
  "dependencies": {
    "arbiter": "file:../Arbiter",
    "@dqbd/tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
